[ -n "$D" ] && OPT="-r $D" || OPT="-s"
        update-rc.d $OPT -f start_ql_forward_le remove
        update-rc.d $OPT start_ql_forward_le start 99 2 3 4 5 . stop 10 0 1 6 .
if type update-rc.d >/dev/null 2>/dev/null; then
	if [ -n "$D" ]; then
		OPT="-r $D"
	else
		OPT="-s"
	fi
	update-rc.d $OPT start_ql_forward_le start 45 2 3 4 5 .
fi
